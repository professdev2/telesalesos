# TelesalesOS — local environment template
#
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Never commit real keys.
# Use the STAGING Supabase project for development (see DEVELOPMENT.md).
# Do not point local development at production.

# Supabase project URL.
# Staging host format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (Dashboard -> Project Settings -> API).
# Format: sb_publishable_...
# This key is browser-safe. It is NOT the service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute origin used to build the links in Supabase auth emails.
# Required for confirmation links once custom SMTP is configured.
# Optional locally — falls back to the request host. Required in any deployed
# environment, otherwise confirmation links point at the wrong hostname.
# Must also be listed under Authentication -> URL Configuration -> Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Vercel (powerbridge-io / telesalesos): set the three NEXT_PUBLIC_* names and
# server-only RESEND_API_KEY on Preview AND Production separately. Preview is
# not inherited by Production. After edits, Redeploy.
# Full checklist: docs/vercel-environments.md
#   Production NEXT_PUBLIC_SITE_URL=https://telesalesos.vercel.app
# Never put service_role or ISOLATION_* on Vercel. Never prefix Resend with
# NEXT_PUBLIC_.

# Server-only Resend key for organization invitation email (hashed join link)
# and Agent Email OTP. Same API key as Staging SMTP password. Without it,
# Members still creates a copyable link and Email OTP cannot be sent. Auth
# confirmation / reset still go through Supabase SMTP.
RESEND_API_KEY=

# Optional dedicated pepper for Email OTP hashes. Defaults to RESEND_API_KEY.
# EMAIL_MFA_PEPPER=

# Isolation-test scripts only (`scripts/isolation-*.mjs`, `scripts/mfa-isolation.mjs`).
# Fill these in `.env.local`. Never put them on Vercel. Never commit real values.
# ISOLATION_A_PASSWORD=
# ISOLATION_B_PASSWORD=
# ISOLATION_A_TOTP_SECRET=
# ISOLATION_B_TOTP_SECRET=

# Server-only Auth admin secret. Required to unenroll TOTP during authenticator
# recovery (user JWTs at AAL1 cannot unenroll). Never NEXT_PUBLIC_. Same value
# as Dashboard → API → service_role / secret key.
# SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Isolation scripts only (not required if SUPABASE_SECRET_KEY is set).
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Training catalog — Pexels thumbnail search (server-only)
# ---------------------------------------------------------------------------
# Optional. Enables "Search images" on course create/edit. Never NEXT_PUBLIC_.
# Get a key at https://www.pexels.com/api/
# PEXELS_API_KEY=

# ---------------------------------------------------------------------------
# PowerBridge website inbound (FormSubmit → CRM)
# ---------------------------------------------------------------------------
# Server-only. Never NEXT_PUBLIC_.
# POST /api/inbound/powerbridge-web?key=<POWERBRIDGE_INBOUND_SECRET>
# POWERBRIDGE_INBOUND_SECRET=
# POWERBRIDGE_INBOUND_ORG_ID=          # Jake Lynn active org (021593fa-…)
# POWERBRIDGE_INBOUND_CAMPAIGN_ID=     # optional; else creates/finds by name
# POWERBRIDGE_INBOUND_CAMPAIGN_NAME=Website Leads
# Optional: only if you want a second email from TelesalesOS (FormSubmit usually keeps email).
# POWERBRIDGE_INBOUND_NOTIFY_EMAIL=jake@jakelynn.com

# ---------------------------------------------------------------------------
# Legacy Telesales recruiting — Typeform webhook
# ---------------------------------------------------------------------------
# POST /api/inbound/legacy-recruiting-typeform?key=<LEGACY_RECRUITING_INBOUND_SECRET>
# Or configure Typeform webhook secret → TYPEFORM_WEBHOOK_SECRET (sha256 signature).
# LEGACY_RECRUITING_INBOUND_SECRET=
# LEGACY_RECRUITING_INBOUND_ORG_ID=
# LEGACY_RECRUITING_INBOUND_CAMPAIGN_ID=
# LEGACY_RECRUITING_INBOUND_CAMPAIGN_NAME=Legacy Recruiting — Typeform
# TYPEFORM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AgentFuel applicants — Typeform webhook ($1600/mo membership)
# ---------------------------------------------------------------------------
# POST /api/inbound/agentfuel-typeform?key=<AGENTFUEL_INBOUND_SECRET>
# AGENTFUEL_INBOUND_SECRET=
# AGENTFUEL_INBOUND_ORG_ID=
# AGENTFUEL_INBOUND_CAMPAIGN_ID=
# AGENTFUEL_INBOUND_CAMPAIGN_NAME=AgentFuel Applicants

# ---------------------------------------------------------------------------
# Stripe billing (TEST / sandbox only until go-live)
# ---------------------------------------------------------------------------
# Create Product + Price in Stripe Dashboard (Test mode).
# Never commit real keys. Never use sk_live_ / pk_live_ until approved.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from Developers → Webhooks


# ---------------------------------------------------------------------------
# Supabase CLI (not read by Next.js)
# ---------------------------------------------------------------------------
# The CLI authenticates separately from these variables:
#   npx supabase login
#   npx supabase link --project-ref <staging-project-ref>
#   npx supabase migration list
# Never store a personal access token in this repository.
